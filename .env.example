# Server-side only. Never expose this key in public/index.html.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SQLITE_PATH=data/bnb-viewer.sqlite
SQLITE_BACKUP_DIR=backups
# Daily maintenance clamps snapshot retention to 30-90 days and daily backups to 14-30 files.
SNAPSHOT_RETENTION_DAYS=60
BACKUP_RETENTION_FILES=21
PORT=3001
# Release identity is injected by scripts/start-background.sh; do not set BNB_RELEASE_REVISION or
# BNB_BUILD_TIMESTAMP manually to bypass scripts/status-background.sh validation.
# Active process entry point is node dist/app/server.js; follow docs/runbook-termux-release.md.
# Bind localhost by default. Use 0.0.0.0 only for a trusted LAN or a hardened reverse proxy.
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# Never expose this service directly to the internet.
# Set true only when exactly one trusted reverse proxy terminates requests and normalizes client IP.
TRUST_PROXY=false
JSON_BODY_LIMIT=32kb
API_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_15_MINUTES=4
EXIT_ADMIN_RATE_LIMIT_PER_MINUTE=60
RPC_HEAVY_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=15000
# Read-only BNB Smart Chain JSON-RPC used for PancakeSwap V3 state.
BSC_RPC_URL=https://bsc-dataseed1.bnbchain.org

# Stage G starts fail-closed in DB-backed SHADOW mode; activation is protected and paper-only.
POSITION_LIFECYCLE_ENABLED=true
# Separate concentrated high-risk portfolio remains paper-only; set false to pause new paper actions.
AGGRESSIVE_PAPER_ENABLED=true
# Five-times-leveraged long/short simulation using minute pool prices only; never sends orders.
DIRECTIONAL_PAPER_ENABLED=true
# Verified mint receipts must be this deep before a live NFT is tracked (1-100).
MINT_RECEIPT_MIN_CONFIRMATIONS=3

# Phase 7 execution control plane. Defaults must remain locked.
# No private key or seed phrase is accepted/stored by this application.
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_MAX_CAPITAL_USD=100
LIVE_EXECUTION_MAX_DAILY_LOSS_USD=5
LIVE_EXECUTION_PROPOSAL_EXPIRY_MINUTES=15
# Use a random value of at least 32 characters for protected admin endpoints.
EXECUTION_ADMIN_TOKEN=
